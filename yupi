<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dark World Multiplayer</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #05000a;
    color: white;
    font-family: monospace;
    overflow: hidden;
}

/* PANTALLAS */

.screen {
    width: 100vw;
    height: 100vh;
    display: none;
    justify-content: center;
    align-items: center;
}

.screen.active {
    display: flex;
}

/* INICIO */

#menu {
    background:
        radial-gradient(circle, #24103d 0%, #08000e 55%, #000 100%);
}

.panel {
    width: min(90%, 650px);
    padding: 40px;
    text-align: center;
    border: 3px solid #8b3dff;
    background: rgba(12, 0, 25, .95);
    box-shadow: 0 0 30px #6a00ff;
}

h1 {
    color: #c77dff;
    font-size: clamp(35px, 8vw, 65px);
    margin: 0 0 10px;
    text-shadow: 0 0 15px #a020ff;
}

.subtitle {
    color: #aaa;
    margin-bottom: 35px;
}

/* PERSONAJES */

.characters {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}

.character {
    width: 120px;
    padding: 15px;
    border: 2px solid #444;
    background: #100018;
    cursor: pointer;
    transition: .2s;
}

.character:hover {
    transform: translateY(-5px);
    border-color: white;
}

.character.selected {
    border-color: #c77dff;
    box-shadow: 0 0 20px #8b3dff;
}

.sprite {
    width: 55px;
    height: 70px;
    margin: auto auto 10px;
    border: 3px solid #111;
    image-rendering: pixelated;
}

/* Personajes */

.blue {
    background:
        linear-gradient(#55b7ff 0 25%, #2455a6 25% 70%, #111 70%);
}

.green {
    background:
        linear-gradient(#7dff75 0 25%, #278b3d 25% 70%, #111 70%);
}

.red {
    background:
        linear-gradient(#ff7777 0 25%, #a62c2c 25% 70%, #111 70%);
}

.yellow {
    background:
        linear-gradient(#fff36b 0 25%, #b69b18 25% 70%, #111 70%);
}

button {
    margin-top: 30px;
    padding: 15px 35px;
    border: 2px solid #c77dff;
    background: #6a00ff;
    color: white;
    font-family: monospace;
    font-size: 18px;
    cursor: pointer;
}

button:hover {
    background: #8b3dff;
    box-shadow: 0 0 20px #8b3dff;
}

/* JUEGO */

#game {
    position: relative;
    display: block;
    background: #111;
}

#world {
    position: absolute;
    width: 1800px;
    height: 1200px;
}

/* LIGHT WORLD */

#game.light {
    background: #79b9e8;
}

#game.light #world {
    background:
        linear-gradient(90deg,
            transparent 0 9%,
            rgba(255,255,255,.08) 9% 10%,
            transparent 10% 19%,
            rgba(255,255,255,.08) 19% 20%,
            transparent 20%
        ),
        #4d9b55;
}

/* DARK WORLD */

#game.dark {
    background: #090014;
}

#game.dark #world {
    background:
        radial-gradient(circle at 20% 30%, #35105e 0 4%, transparent 5%),
        radial-gradient(circle at 70% 60%, #1e0750 0 5%, transparent 6%),
        #120020;
}

/* DECORACIÓN DEL MAPA */

.tree {
    position: absolute;
    width: 65px;
    height: 90px;
    background: #12652c;
    border: 5px solid #073616;
    border-radius: 50%;
}

.rock {
    position: absolute;
    width: 60px;
    height: 35px;
    background: #777;
    border: 4px solid #333;
    border-radius: 50%;
}

.building {
    position: absolute;
    width: 230px;
    height: 150px;
    background: #d8d8d8;
    border: 8px solid #333;
}

.darkBuilding {
    background: #351050;
    border-color: #8b3dff;
}

/* PORTAL */

.portal {
    position: absolute;
    width: 100px;
    height: 140px;
    border-radius: 50%;
    border: 8px solid #c77dff;
    background: radial-gradient(circle, #fff 0%, #b400ff 20%, #22002f 70%);
    box-shadow: 0 0 35px #b400ff;
    cursor: pointer;
}

/* JUGADOR */

#player {
    position: absolute;
    width: 45px;
    height: 60px;
    z-index: 20;
    border: 4px solid #111;
    box-shadow: 0 0 10px rgba(255,255,255,.5);
}

.playerName {
    position: absolute;
    top: -25px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    color: white;
    font-size: 13px;
}

/* HUD */

#hud {
    position: fixed;
    z-index: 100;
    top: 15px;
    left: 15px;
    padding: 12px 18px;
    background: rgba(0,0,0,.75);
    border: 2px solid #c77dff;
}

#worldName {
    color: #c77dff;
}

#controls {
    position: fixed;
    z-index: 100;
    bottom: 15px;
    left: 50%;
    transform: translateX(-50%);
    padding: 10px 18px;
    background: rgba(0,0,0,.75);
    border: 1px solid #555;
}

/* BOTÓN CAMBIAR MUNDO */

#changeWorld {
    position: fixed;
    z-index: 101;
    top: 15px;
    right: 15px;
    margin: 0;
    padding: 10px 15px;
    font-size: 14px;
}
</style>
</head>

<body>

<!-- ================= MENU ================= -->

<section id="menu" class="screen active">

    <div class="panel">

        <h1>🌑 DARK WORLD</h1>

        <p class="subtitle">
            Una nueva aventura comienza...
        </p>

        <h2>ELIGE TU PERSONAJE</h2>

        <div class="characters">

            <div class="character selected" data-color="blue">
                <div class="sprite blue"></div>
                <b>AZUL</b>
                <p>Equilibrado</p>
            </div>

            <div class="character" data-color="green">
                <div class="sprite green"></div>
                <b>VERDE</b>
                <p>Rápido</p>
            </div>

            <div class="character" data-color="red">
                <div class="sprite red"></div>
                <b>ROJO</b>
                <p>Fuerte</p>
            </div>

            <div class="character" data-color="yellow">
                <div class="sprite yellow"></div>
                <b>AMARILLO</b>
                <p>Ágil</p>
            </div>

        </div>

        <button id="start">
            ABRIR LA FUENTE
        </button>

    </div>

</section>


<!-- ================= JUEGO ================= -->

<section id="game" class="screen light">

    <div id="hud">
        🌎 Mundo:
        <span id="worldName">LIGHT WORLD</span>
        <br>
        👤 Jugador:
        <span id="playerColor">AZUL</span>
    </div>

    <button id="changeWorld">
        🌑 Cambiar mundo
    </button>

    <div id="controls">
        WASD / FLECHAS — Moverse
    </div>

    <div id="world">

        <!-- DECORACIÓN LIGHT WORLD -->

        <div class="tree" style="left:150px;top:150px"></div>
        <div class="tree" style="left:500px;top:300px"></div>
        <div class="tree" style="left:900px;top:170px"></div>
        <div class="tree" style="left:1300px;top:500px"></div>

        <div class="rock" style="left:350px;top:550px"></div>
        <div class="rock" style="left:750px;top:700px"></div>
        <div class="rock" style="left:1100px;top:350px"></div>

        <div class="building" style="left:700px;top:200px"></div>

        <!-- PORTAL -->

        <div
            id="portal"
            class="portal"
            style="left:1450px;top:850px">
        </div>

        <!-- JUGADOR -->

        <div id="player" class="blue" style="left:400px;top:400px">
            <div class="playerName">PLAYER</div>
        </div>

    </div>

</section>


<script>

/* ================= VARIABLES ================= */

let selectedColor = "blue";

let playerX = 400;
let playerY = 400;

let speed = 5;

let keys = {};

let currentWorld = "light";


/* ================= PERSONAJE ================= */

const characters = document.querySelectorAll(".character");

characters.forEach(character => {

    character.addEventListener("click", () => {

        characters.forEach(c =>
            c.classList.remove("selected")
        );

        character.classList.add("selected");

        selectedColor =
            character.dataset.color;

    });

});


/* ================= INICIAR ================= */

document.getElementById("start").addEventListener("click", () => {

    document.getElementById("menu")
        .classList.remove("active");

    document.getElementById("game")
        .classList.add("active");

    const player =
        document.getElementById("player");

    player.className = selectedColor;

    document.getElementById("playerColor")
        .textContent =
        selectedColor.toUpperCase();

    centerCamera();

});


/* ================= CONTROLES ================= */

document.addEventListener("keydown", event => {

    keys[event.key.toLowerCase()] = true;

});


document.addEventListener("keyup", event => {

    keys[event.key.toLowerCase()] = false;

});


/* ================= MOVIMIENTO ================= */

function updatePlayer() {

    if (!document
        .getElementById("game")
        .classList.contains("active")) {
        return;
    }

    if (
        keys["w"] ||
        keys["arrowup"]
    ) {
        playerY -= speed;
    }

    if (
        keys["s"] ||
        keys["arrowdown"]
    ) {
        playerY += speed;
    }

    if (
        keys["a"] ||
        keys["arrowleft"]
    ) {
        playerX -= speed;
    }

    if (
        keys["d"] ||
        keys["arrowright"]
    ) {
        playerX += speed;
    }

    /* límites del mapa */

    playerX =
        Math.max(
            0,
            Math.min(
                1750,
                playerX
            )
        );

    playerY =
        Math.max(
            0,
            Math.min(
                1150,
                playerY
            )
        );

    document.getElementById("player")
        .style.left =
        playerX + "px";

    document.getElementById("player")
        .style.top =
        playerY + "px";

    centerCamera();

    checkPortal();

}


/* ================= CÁMARA ================= */

function centerCamera() {

    const game =
        document.getElementById("game");

    const world =
        document.getElementById("world");

    const cameraX =
        playerX -
        window.innerWidth / 2 +
        22;

    const cameraY =
        playerY -
        window.innerHeight / 2 +
        30;

    world.style.transform =
        `translate(${-cameraX}px, ${-cameraY}px)`;

}


/* ================= PORTAL ================= */

function checkPortal() {

    const portalX = 1450;
    const portalY = 850;

    const distance =
        Math.sqrt(
            Math.pow(playerX - portalX, 2) +
            Math.pow(playerY - portalY, 2)
        );

    if (distance < 120) {

        document.getElementById("portal")
            .style.boxShadow =
            "0 0 80px white";

    } else {

        document.getElementById("portal")
            .style.boxShadow =
            "0 0 35px #b400ff";

    }

}


/* ================= CAMBIAR MUNDO ================= */

document.getElementById("changeWorld")
    .addEventListener("click", changeWorld);


